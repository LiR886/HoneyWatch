RAPID_REQUEST_THRESHOLD=10
RAPID_REQUEST_WINDOW_SECONDS=10
ALERT_COOLDOWN_SECONDS=60

HIGH_VALUE_USERNAMES=admin,administrator,root,sysadmin,support
